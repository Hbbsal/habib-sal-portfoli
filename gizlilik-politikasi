<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <title>Gizlilik Politikası</title>
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; margin: 20px; }
    h1 { color: #333; }
    h2 { color: #555; }
    .section { margin-bottom: 20px; }
    .lang { font-weight: bold; margin-top: 10px; }
  </style>
